<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>gw.ico</ApplicationIcon>
    <PackageIcon>gw.png</PackageIcon>
  </PropertyGroup>

  <!-- Keep the assembly version aligned with the ClickOnce publish profile (e.g. 1.0.0.7). -->
  <Target Name="ApplyClickOnceVersionToAssembly"
          BeforeTargets="GenerateAssemblyInfo;GetAssemblyVersion;CoreGenerateAssemblyInfo"
          Condition="Exists('$(MSBuildProjectDirectory)\Properties\PublishProfiles\ClickOnceProfile.pubxml')">
    <XmlPeek XmlInputPath="$(MSBuildProjectDirectory)\Properties\PublishProfiles\ClickOnceProfile.pubxml"
             Query="/Project/PropertyGroup/ApplicationVersion/text()">
      <Output TaskParameter="Result" PropertyName="_ClickOnceApplicationVersion" />
    </XmlPeek>
    <XmlPeek XmlInputPath="$(MSBuildProjectDirectory)\Properties\PublishProfiles\ClickOnceProfile.pubxml"
             Query="/Project/PropertyGroup/ApplicationRevision/text()">
      <Output TaskParameter="Result" PropertyName="_ClickOnceApplicationRevision" />
    </XmlPeek>
    <PropertyGroup Condition="'$(_ClickOnceApplicationVersion)' != '' and '$(_ClickOnceApplicationRevision)' != ''">
      <_ClickOnceVersionBase>$([System.String]::Copy('$(_ClickOnceApplicationVersion)').Replace('*', '').TrimEnd('.'))</_ClickOnceVersionBase>
      <Version>$(_ClickOnceVersionBase).$(_ClickOnceApplicationRevision)</Version>
      <AssemblyVersion>$(Version)</AssemblyVersion>
      <FileVersion>$(Version)</FileVersion>
      <InformationalVersion>$(Version)</InformationalVersion>
    </PropertyGroup>
  </Target>

  <ItemGroup>
    <Content Include="gw.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="gw.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.0.2" />
    <PackageReference Include="Microsoft.Identity.Client" Version="4.84.2" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="_probe/**" />
    <Compile Remove="RefreshVIR.Tests/**" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RefreshVIR.Tests" />
  </ItemGroup>

</Project>